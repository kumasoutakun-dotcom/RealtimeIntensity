<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000049">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="気象庁の3成分CSV、または本アプリから書き出した同形式のX/Y/Z CSVを1ファイル選択します。"
            android:textSize="13sp"
            android:textColor="#E7ECF7"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPickData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3成分CSVを選択"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:includeFontPadding="false"
            android:textColor="#102046"
            android:backgroundTint="#8FA7E8"
            app:cornerRadius="20dp" />

        <TextView
            android:id="@+id/textPickedFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="未選択"
            android:textSize="12sp"
            android:textColor="#C0C8D8"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="検証を実行"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:minHeight="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:includeFontPadding="false"
            android:textColor="#F3F6FF"
            android:backgroundTint="#3A527D"
            app:cornerRadius="20dp" />

        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#E7ECF7"
            android:includeFontPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>
</ScrollView>
