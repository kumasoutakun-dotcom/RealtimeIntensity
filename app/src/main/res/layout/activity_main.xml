<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <!--
      コンパクトな計測モニター用の2列レイアウト。
        行1: 左上=震度階級 / 右上=震度推移
        行2: 左下=計測震度相当+加速度 / 右下=XYZ加速度波形
      各Viewのid・データ供給元・更新頻度・ロジックはMainActivity.kt側で
      一切変更していない(震度階級・震度推移・計測震度相当・加速度・
      XYZ加速度波形は、いずれも既存と同じidのViewを配置場所だけ変更している)。
    -->
    <LinearLayout
        android:id="@+id/intensityCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#26314A"
        android:padding="10dp">

        <!-- 行1: 左上=震度階級 / 右上=震度推移 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 左上: 震度階級 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/labelIntensityClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_intensity_class"
                    android:textSize="12sp"
                    android:textColor="#C0C8D8" />

                <TextView
                    android:id="@+id/textIntensityClassBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="--"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 右上: 震度推移(履歴帯) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_intensity_history"
                    android:textSize="12sp"
                    android:textColor="#C0C8D8" />

                <com.example.rtintensity.ui.IntensityHistoryBandView
                    android:id="@+id/intensityHistoryBand"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 行2: 左下=計測震度相当+加速度 / 右下=XYZ加速度波形 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- 左下: 計測震度相当 + 加速度 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_measured_intensity"
                    android:textSize="11sp"
                    android:textColor="#C0C8D8" />
                <TextView
                    android:id="@+id/textMeasuredIntensity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
                <!--
                  計測震度相当の現在値を、100段階色マップ(KyoshinShindoColorMap)で
                  1色に変換した単色バー(時間履歴ではない)。色決定処理は
                  MainActivity.kt側で変更していない。
                -->
                <View
                    android:id="@+id/underlineMeasuredIntensity"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="2dp"
                    android:background="#808080" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_measured_acceleration"
                    android:textSize="11sp"
                    android:textColor="#C0C8D8" />
                <TextView
                    android:id="@+id/textMeasuredAcceleration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
                <!-- 加速度(PGA相当)の現在値による単色バー(時間履歴ではない)。 -->
                <View
                    android:id="@+id/underlineMeasuredAcceleration"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="2dp"
                    android:background="#808080" />
            </LinearLayout>

            <!-- 右下: XYZ加速度波形(現在のXYZ軸波形) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_xyz_displacement"
                    android:textSize="11sp"
                    android:textColor="#C0C8D8" />
                <com.example.rtintensity.ui.WaveformView
                    android:id="@+id/waveformXyz"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/credit_kyoshin_shindo_color_map"
            android:textSize="9sp"
            android:textColor="#8C94A6" />

    </LinearLayout>

    <TextView
        android:id="@+id/textDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/label_disclaimer"
        android:textSize="10sp"
        android:textColor="#808080" />

    <!--
      下部の詳細情報。上部の2列モニターと完全に重複する項目
      (計測震度[旧textIntensityValue]、加速度相当を表す3軸合成、
       X/Y/Zの現在値)は削除した。サンプリング周波数・センサー状態・
      静止時オフセットなど、上部に無い技術的な診断情報は維持している。
    -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:columnCount="2">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="サンプリング周波数" android:layout_column="0" android:layout_row="0"/>
        <TextView android:id="@+id/textSampleRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- Hz" android:layout_column="1" android:layout_row="0"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="センサー状態" android:layout_column="0" android:layout_row="1"/>
        <TextView android:id="@+id/textSensorStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="未取得" android:layout_column="1" android:layout_row="1"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="静止時オフセット(平均±標準偏差,gal)" android:layout_column="0" android:layout_row="2"/>
        <TextView android:id="@+id/textCalibration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="計測中..." android:layout_column="1" android:layout_row="2"/>

    </GridLayout>

    <com.example.rtintensity.ui.WaveformView
        android:id="@+id/waveformRaw"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="10dp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="生の3軸合成加速度(フィルタ前)" android:textSize="11sp"/>

    <com.example.rtintensity.ui.WaveformView
        android:id="@+id/waveformFiltered"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="6dp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="フィルタ後の3軸合成加速度" android:textSize="11sp"/>

    <com.example.rtintensity.ui.WaveformView
        android:id="@+id/waveformIntensity"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="6dp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="リアルタイム震度相当値の推移" android:textSize="11sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonStartStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/buttonValidation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_validation" />
    </LinearLayout>

    <TextView
        android:id="@+id/textRecordingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textSize="12sp" />

</LinearLayout>
</ScrollView>
